{
  "manifest_version": 3,
  "name": "Smartfill \u2014 AI Form Autofill",
  "version": "0.12.1",
  "description": "Fills any form from your saved profile, attaches the right resume for the role, and asks Claude to work out the fields it doesn't recognise.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Smartfill",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "js": [
        "src/common/schema.js",
        "src/content/fields.js",
        "src/content/files.js",
        "src/content/rules.js",
        "src/content/filler.js",
        "src/content/rows.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/ui.css"
      ]
    }
  ],
  "commands": {
    "smartfill-run": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this form"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}